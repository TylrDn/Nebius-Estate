# Every credential and identifier this repository reads, in one place. Names only — no values.
# How to create each one: docs/credentials.md.
#
#   cp .env.example .env && chmod 600 .env      # .env is git-ignored; fill in what you have
#   make env-status                              # which slots are set (never prints values)
#   set -a; source .env; set +a                  # load into the current shell before make / yarn start
#
# Rules: private keys live as FILES under secrets/ (git-ignored, mode 600) and are referenced by path;
# short-lived tokens (NEBIUS_IAM_TOKEN, TF_VAR_iam_token, ~12 h) are minted on demand by the nebius
# CLI and are never stored here; real IDs never leave this file (CONTRIBUTING: no real IDs in git).

# ---- 1. Nebius account scope (identifiers, not secrets; needed by every script) ----------------
# Console → tenant/project pickers, or: nebius iam v2 tenant list / nebius iam v2 project list --parent-id <tenant>
NEBIUS_TENANT_ID=
NEBIUS_PROJECT_ID=            # the project the current command acts on (one per stage, ADR-0009)
NEBIUS_REGION=eu-north1       # platform/regions.yaml
NEBIUS_PROFILE=               # nebius CLI profile to use (empty = the CLI default profile)

# ---- 2. Portal live inventory: a READ-ONLY service account (docs/portal/nebius-setup.md) --------
# A service account in a CUSTOM group with one `viewer` access permit per listed project, plus an
# authorized key pair (docs/credentials.md#portal-read-only-service-account). Never the default
# `viewers` group: it is tenant-wide, and `viewer` also reads data (e.g. downloads bucket objects).
NEBIUS_PROJECT_IDS=           # comma-separated projects the portal inventories
NEBIUS_SA_ID=                 # serviceaccount-...
NEBIUS_SA_PUBLIC_KEY_ID=      # publickey-...
NEBIUS_SA_PRIVATE_KEY_FILE=secrets/portal-viewer.pem   # private.pem from openssl genrsa; public half registered with `nebius iam auth-public-key create`
# Optional connectors (each read-only; leave empty to show "not configured"):
K8S_SANDBOX_INFERENCE_TOKEN=  # NON-Nebius clusters only; Managed Kubernetes uses the service account above (docs/credentials.md#kubernetes-read-only-token)
PROMETHEUS_TOKEN=             # OBSERVABILITY static key for Grafana/other tools on the Nebius Prometheus endpoint; the portal does not need it (docs/credentials.md#observability-static-key)

# ---- 3. Terraform state (R2): minted per session by scripts/bootstrap-backend.sh, 1-day expiry ----
# Leave empty locally; `source scripts/bootstrap-backend.sh <stage> <stack>` exports fresh ones.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- 4. Deploy-time inputs that must never be committed --------------------------------------
TF_VAR_allowed_cidrs=         # JSON list of your office/VPN egress, e.g. ["198.18.0.10/32"]; RFC 5737 ranges are refused
TF_VAR_backups_password=      # Soperator jail backups (R4), when backups are on
TF_VAR_slurm_login_ssh_root_public_keys=   # JSON list of PUBLIC keys for the Slurm login node (not secret)
TF_VAR_ssh_public_key=        # R10 gpu-vm: OpenSSH PUBLIC key for nip-admin (not secret; CI: variable NIP_SSH_PUBLIC_KEY)
TF_VAR_mlflow_admin_password= # R12 ml-services, only with enable_mlflow and no secret_id: 8-64 chars, upper+lower+digit+special; ephemeral, never in plan or state
TF_VAR_postgresql_password=   # R12 ml-services, only with enable_postgresql and no secret_id: 8+ chars, upper+lower+special. Prefer SecretStash (docs/credentials.md#secretstash)

# ---- 5. CI pipeline (GitHub Environment secrets, NOT this file in CI) ---------------------------
# Kept here only for local dry runs of scripts/ci-token.sh. In GitHub: environments <stage>-plan and
# <stage> hold NEBIUS_TENANT_ID, NEBIUS_PROJECT_ID, NIP_SA_ID, NIP_SA_KEY_ID, NIP_SA_PRIVATE_KEY,
# NIP_STATE_ACCESS_KEY_ID, NIP_STATE_SECRET_ACCESS_KEY (docs/change-management.md, runbooks/credential-rotation.md).
# Federated path (R13, runbooks/identity.md): the environment holds NIP_SA_ID only; the job's GitHub
# OIDC token is swapped at Nebius STS, so there is no key to store, here or in GitHub.
NIP_SA_ID=                    # foundation output ci_identities.<stage>.service_account_id (federated: output ci_federation)
NIP_SA_KEY_ID=                # .metadata.id from `nebius iam auth-public-key create` (docs/credentials.md#ci-service-account-keys)
NIP_SA_KEY_FILE=secrets/ci-sandbox.pem   # one key file per stage: ci-sandbox / ci-staging / ci-prod

# ---- 6. Data plane (R8) transfers from a customer bucket: per engagement, never committed --------
TF_VAR_transfer_source_secret_key=
TF_VAR_transfer_destination_secret_key=

# ---- 7. Token Factory (R11, recipes/token-factory) and other API keys ------------------------
NEBIUS_API_KEY=               # Token Factory API key (OpenAI-compatible); console → API keys; R11 scripts and the portal (docs/credentials.md#other-slots)
NIP_TF_BASE_URL=              # optional, not secret: Token Factory base URL (empty = https://api.tokenfactory.nebius.com/v1)
HF_TOKEN=                     # optional Hugging Face read token: read by the portal backend only (docs/credentials.md#other-slots); no workload here uses it (the lab models are Apache-2.0)
GITHUB_TOKEN=                 # gh CLI / lychee link checks without throttling (read-only, public_repo scope)
AUTH_GITHUB_CLIENT_ID=        # portal production sign-in (GitHub OAuth app), docs/portal/security.md
AUTH_GITHUB_CLIENT_SECRET=

# ---- 8. Billing export pull (portal): read-only S3 key of the portal service account ----------
# Console: Billing → Export → Periodic export to this bucket (FOCUS). Key: docs/credentials.md#billing-export-pull.
NEBIUS_BILLING_EXPORT_BUCKET=
NEBIUS_BILLING_EXPORT_REGION=
NEBIUS_BILLING_EXPORT_PREFIX=                 # optional key prefix the export writes under
NEBIUS_BILLING_EXPORT_ACCESS_KEY_ID=
NEBIUS_BILLING_EXPORT_SECRET_ACCESS_KEY=
