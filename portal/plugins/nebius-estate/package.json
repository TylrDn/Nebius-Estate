{
  "name": "@internal/backstage-plugin-nebius-estate",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Nebius Estate frontend: overview, estate explorer, GPU & capacity, workloads, provisioning, costs, commercial scenarios, evidence & runbooks, integrations & coverage.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/ui/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "nebius-estate"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/core-components": "^0.18.14",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@internal/nebius-domain": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "react": "^18.0.2",
    "react-router-dom": "7.18.4"
  },
  "files": [
    "dist"
  ]
}
