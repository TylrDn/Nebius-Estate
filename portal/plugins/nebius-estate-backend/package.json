{
  "name": "@internal/backstage-plugin-nebius-estate-backend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Nebius Estate backend: read-only inventory connectors, repository model, evidence index, capacity and workload views, provisioning previews, FOCUS billing, rate books, scenarios and draft quotes.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/lib/config.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "config": [
        "src/lib/config.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "nebius-estate"
  },
  "configSchema": "config.d.ts",
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "verify:live": "CI=1 NEBIUS_VERIFY_LIVE=1 backstage-cli package test src/verify-live.test.ts --runInBand --coverage=false --watchAll=false"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/config": "^1.3.9",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-permission-common": "^0.9.11",
    "@internal/nebius-domain": "workspace:^",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "knex": "^3.3.0",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.7",
    "@backstage/cli": "^0.36.6",
    "@backstage/config-loader": "^1.11.3",
    "@types/express": "^4.17.6",
    "@types/supertest": "^2.0.12",
    "supertest": "^7.3.1",
    "yaml": "^2.9.1"
  },
  "files": [
    "dist",
    "migrations",
    "config.d.ts"
  ]
}
